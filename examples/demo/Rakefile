require_relative 'config/application'
Rails.application.load_tasks

namespace :assets do
  desc 'Build ActiveAdmin 4 styles without Node/npm'
  task :build do
    source = Rails.root.join('app/assets/stylesheets/active_admin.tailwind.css')
    generated = Rails.root.join('tmp/active_admin.tailwind.css')
    css = source.read.gsub('@source "../../../../../app/views";', '')
    css << "\n@source \"#{Gem::Specification.find_by_name('activeadmin').full_gem_path}/app/views\";\n"
    css << "@source \"#{Gem::Specification.find_by_name('activeadmin').full_gem_path}/vendor\";\n"
    generated.write(css)
    system('bundle', 'exec', 'tailwindcss', '-i', generated.to_s,
           '-o', Rails.root.join('app/assets/active_admin.css').to_s, exception: true)
  end
end
